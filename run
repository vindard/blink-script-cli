#!/bin/bash

set -euo pipefail

# Print usage information
usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [options] [args]

Commands:
  csv_transactions               Fetch csv transactions
  help                           Show this help message
EOF
}

# Ensure at least one argument
if (( $# < 1 )); then
  usage
  exit 1
fi

# Grab and consume the subcommand
cmd=$1
shift

case "$cmd" in
  csv_transactions)
    # Example: ./run csv_transactions
    ./cmds/csv_transactions
    echo "> written to ./results/transactions.csv"
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    echo "Error: Unknown command: '$cmd'" >&2
    echo
    usage
    exit 1
    ;;
esac
